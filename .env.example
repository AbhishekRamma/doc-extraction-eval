# Copy to .env (gitignored) and fill in only what you use. Never commit real keys.
# The free path (rules/cached extractors, local OCR) needs none of the API keys.

# DeepSeek API key: only for --provider deepseek (paid; every run bills).
DEEPSEEK_API_KEY=
# OpenAI API key: only for --provider openai (paid).
OPENAI_API_KEY=
# Anthropic API key: only for --provider anthropic (paid).
ANTHROPIC_API_KEY=

# Postgres for src/load_db.py and tests/test_load_db.py (matches docker compose / CI).
DATABASE_URL=postgresql://receipts:receipts@localhost:5432/receipts

# MongoDB for src/load_mongo.py, scripts/mongo_parity.py and the Mongo tests (optional).
# Local demo credentials, matching the `mongo` service in docker compose and CI; not a secret.
MONGO_URL=mongodb://receipts:receipts@localhost:27017/receipts?authSource=admin
